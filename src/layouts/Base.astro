---
import '../styles/global.css';
import { perfil } from '../data/perfil';
import Bicho from '../components/Bicho.astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  sinBicho?: boolean; // en las páginas de error no sale el bicho del easter egg
  noIndexar?: boolean;
}

const { titulo, descripcion = perfil.frase, sinBicho = false, noIndexar = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${perfil.nombre}` : `${perfil.nombre} · ${perfil.rol}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// imagen al compartir el link (generada con: npm run og). Debe ser una URL absoluta.
const imagenCompartir = new URL('/og.png', Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Modo liviano: si el navegador dibuja por software (sin aceleración por hardware),
      // se apagan los efectos decorativos caros (ver .liviano en global.css).
      // Forzar a mano: ?liviano=1 o ?liviano=0 en la URL.
      (function () {
        var forzado = new URLSearchParams(location.search).get('liviano');
        if (window.__forzarLiviano !== undefined) forzado = window.__forzarLiviano ? '1' : '0';
        var liviano = forzado === '1';
        if (forzado === null) {
          try {
            var gl = document.createElement('canvas').getContext('webgl');
            if (!gl) {
              liviano = true;
            } else {
              var info = gl.getExtension('WEBGL_debug_renderer_info');
              var motor = String(gl.getParameter(info ? info.UNMASKED_RENDERER_WEBGL : gl.RENDERER));
              liviano = /swiftshader|llvmpipe|softpipe|software|basic render/i.test(motor);
              var perder = gl.getExtension('WEBGL_lose_context');
              if (perder) perder.loseContext();
            }
          } catch (e) {
            liviano = true;
          }
        }
        if (liviano) document.documentElement.classList.add('liviano');
      })();
    </script>
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#03020a" />
    {noIndexar && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={perfil.nombre} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${perfil.nombre}, ${perfil.rol}: ${perfil.frase}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagenCompartir} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="barra">
      <nav class="contenedor nav" aria-label="Principal">
        <a class="marca" href={`${base}/`}>
          <span class="punto" aria-hidden="true"></span>{perfil.nombre}
        </a>
        <ul>
          <li><a href={`${base}/#proyectos`}>Proyectos</a></li>
          <li><a href={`${base}/#experiencia`}>Experiencia</a></li>
          <li><a href={`${base}/#stack`}>Stack</a></li>
          <li><a href={`${base}/#contacto`}>Contacto</a></li>
        </ul>
      </nav>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="pie">
      <div class="contenedor">
        <p class="muted">
          © {new Date().getFullYear()} {perfil.nombre} · Hecho con Astro y probado con Playwright
          {perfil.repoSitio && (
            <>
              {' '}· <a href={perfil.repoSitio} target="_blank" rel="noopener noreferrer">ver código</a>
            </>
          )}
        </p>
      </div>
    </footer>
    {!sinBicho && <Bicho />}

    <script>
      // Hace aparecer suavemente los elementos .revelar cuando entran en pantalla.
      const elementos = document.querySelectorAll('.revelar');
      if ('IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                obs.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        elementos.forEach((el) => obs.observe(el));
      } else {
        elementos.forEach((el) => el.classList.add('visible'));
      }
    </script>
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: -9999px;
  }
  .saltar:focus {
    left: 16px;
    top: 16px;
    z-index: 100;
    background: var(--surface-solid);
    padding: 8px 12px;
  }
  .barra {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(3, 2, 10, 0.6);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
    flex-wrap: wrap;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  .punto {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--lila-300);
    box-shadow: 0 0 12px 2px rgba(190, 150, 255, 0.8);
  }
  .nav ul {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .nav ul a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s, text-shadow 0.2s;
  }
  .nav ul a:hover {
    color: var(--text);
    text-shadow: 0 0 14px rgba(185, 166, 255, 0.8);
  }
  .pie {
    border-top: 1px solid var(--border);
    padding: 32px 0;
    font-size: 0.9rem;
  }
  @media (max-width: 560px) {
    .nav {
      padding-top: 10px;
      padding-bottom: 10px;
    }
    .nav ul {
      gap: 16px;
    }
  }
</style>
