---
import '../styles/global.css';
import { perfil } from '../data/perfil';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { titulo, descripcion = perfil.frase } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${perfil.nombre}` : `${perfil.nombre} · ${perfil.rol}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="barra">
      <nav class="contenedor nav" aria-label="Principal">
        <a class="marca" href={`${base}/`}>{perfil.nombre}</a>
        <ul>
          <li><a href={`${base}/#proyectos`}>Proyectos</a></li>
          <li><a href={`${base}/#experiencia`}>Experiencia</a></li>
          <li><a href={`${base}/#stack`}>Stack</a></li>
          <li><a href={`${base}/#contacto`}>Contacto</a></li>
        </ul>
      </nav>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="pie">
      <div class="contenedor">
        <p class="muted">
          © {new Date().getFullYear()} {perfil.nombre}. Hecho con Astro y probado con Playwright
          {perfil.repoSitio && (
            <>
              {' '}· <a href={perfil.repoSitio} target="_blank" rel="noopener noreferrer">ver código</a>
            </>
          )}
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: -9999px;
  }
  .saltar:focus {
    left: 16px;
    top: 16px;
    z-index: 100;
    background: var(--surface);
    padding: 8px 12px;
  }
  .barra {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    flex-wrap: wrap;
  }
  .marca {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  .nav ul {
    display: flex;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .nav ul a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .nav ul a:hover {
    color: var(--text);
  }
  .pie {
    border-top: 1px solid var(--border);
    padding: 28px 0;
    font-size: 0.9rem;
  }
  @media (max-width: 560px) {
    .nav {
      padding-top: 10px;
      padding-bottom: 10px;
    }
    .nav ul {
      gap: 14px;
    }
  }
</style>
