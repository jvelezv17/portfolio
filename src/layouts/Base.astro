---
import '../styles/global.css';
import { contenido } from '../data';
import { textos, rutas, prefijo, type Idioma } from '../i18n';
import Bicho from '../components/Bicho.astro';

interface Props {
  idioma?: Idioma;
  /** Ruta de esta misma página en el otro idioma (para el selector ES | EN y para Google). */
  alterna?: string;
  titulo?: string;
  descripcion?: string;
  sinBicho?: boolean; // en las páginas de error no sale el bicho del easter egg
  noIndexar?: boolean;
}

const { idioma = 'es', titulo, sinBicho = false, noIndexar = false } = Astro.props;
const otro: Idioma = idioma === 'es' ? 'en' : 'es';
const alterna = Astro.props.alterna ?? rutas.inicio[otro];
const { perfil } = contenido(idioma);
const t = textos[idioma];
const descripcion = Astro.props.descripcion ?? perfil.frase;
const tituloCompleto = titulo ? `${titulo} · ${perfil.nombre}` : `${perfil.nombre} · ${perfil.rol}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const urlEs = new URL(idioma === 'es' ? Astro.url.pathname : alterna, Astro.site);
const urlEn = new URL(idioma === 'en' ? Astro.url.pathname : alterna, Astro.site);
// imagen al compartir el link (generada con: npm run og). Debe ser una URL absoluta.
const imagenCompartir = new URL(idioma === 'en' ? '/og-en.png' : '/og.png', Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const inicio = `${base}${prefijo(idioma)}/`;
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Modo liviano: si el navegador dibuja por software (sin aceleración por hardware),
      // se apagan los efectos decorativos caros (ver .liviano en global.css).
      // Forzar a mano: ?liviano=1 o ?liviano=0 en la URL.
      (function () {
        var forzado = new URLSearchParams(location.search).get('liviano');
        if (window.__forzarLiviano !== undefined) forzado = window.__forzarLiviano ? '1' : '0';
        var liviano = forzado === '1';
        if (forzado === null) {
          try {
            var gl = document.createElement('canvas').getContext('webgl');
            if (!gl) {
              liviano = true;
            } else {
              var info = gl.getExtension('WEBGL_debug_renderer_info');
              var motor = String(gl.getParameter(info ? info.UNMASKED_RENDERER_WEBGL : gl.RENDERER));
              liviano = /swiftshader|llvmpipe|softpipe|software|basic render/i.test(motor);
              var perder = gl.getExtension('WEBGL_lose_context');
              if (perder) perder.loseContext();
            }
          } catch (e) {
            liviano = true;
          }
        }
        if (liviano) document.documentElement.classList.add('liviano');

        // iPhone / iPad (todos sus navegadores usan el motor de Safari): las cintas de luz
        // quedan quietas (ver .ios en global.css). Se reportó que el inicio y la 404 se
        // trababan en iOS, y ahí es donde están las cintas. ?ios=1 lo fuerza para probar.
        var esIos =
          /iPhone|iPad|iPod/.test(navigator.userAgent) ||
          (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1); // iPad con iPadOS
        if (esIos || new URLSearchParams(location.search).get('ios') === '1') {
          document.documentElement.classList.add('ios');
        }
      })();
    </script>
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#03020a" />
    {noIndexar && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {!noIndexar && <link rel="alternate" hreflang="es" href={urlEs} />}
    {!noIndexar && <link rel="alternate" hreflang="en" href={urlEn} />}
    {!noIndexar && <link rel="alternate" hreflang="x-default" href={urlEs} />}
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={perfil.nombre} />
    <meta property="og:locale" content={idioma === 'en' ? 'en_US' : 'es_CO'} />
    <meta property="og:locale:alternate" content={idioma === 'en' ? 'es_CO' : 'en_US'} />
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${perfil.nombre}, ${perfil.rol}: ${perfil.frase}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagenCompartir} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
  </head>
  <body>
    <a class="saltar" href="#contenido">{t.saltar}</a>
    <header class="barra">
      <nav class="contenedor nav" aria-label={idioma === 'en' ? 'Main' : 'Principal'}>
        <a class="marca" href={inicio}>
          <span class="punto" aria-hidden="true"></span>{perfil.nombre}
        </a>
        <ul>
          <li><a href={`${inicio}#proyectos`}>{t.menu.proyectos}</a></li>
          <li><a href={`${inicio}#experiencia`}>{t.menu.experiencia}</a></li>
          <li><a href={`${inicio}#stack`}>{t.menu.stack}</a></li>
          <li><a href={`${inicio}#contacto`}>{t.menu.contacto}</a></li>
          <li>
            <a
              class="idioma"
              href={`${base}${alterna}`}
              hreflang={otro}
              aria-label={t.cambiarIdioma}
              data-testid="cambiar-idioma"
            >
              <span class:list={[{ activo: idioma === 'es' }]}>ES</span><span class="barra-idioma" aria-hidden="true"
                >/</span
              ><span class:list={[{ activo: idioma === 'en' }]}>EN</span>
            </a>
          </li>
        </ul>
      </nav>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="pie">
      <div class="contenedor">
        <p class="muted">
          © {new Date().getFullYear()} {perfil.nombre} · {t.pie}
          {perfil.repoSitio && (
            <>
              {' '}· <a href={perfil.repoSitio} target="_blank" rel="noopener noreferrer">{t.verCodigo}</a>
            </>
          )}
        </p>
      </div>
    </footer>
    {!sinBicho && <Bicho idioma={idioma} />}

    <script>
      // Hace aparecer suavemente los elementos .revelar cuando entran en pantalla.
      const elementos = document.querySelectorAll('.revelar');
      if ('IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                obs.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        elementos.forEach((el) => obs.observe(el));
      } else {
        elementos.forEach((el) => el.classList.add('visible'));
      }
    </script>
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: -9999px;
  }
  .saltar:focus {
    left: 16px;
    top: 16px;
    z-index: 100;
    background: var(--surface-solid);
    padding: 8px 12px;
  }
  .barra {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(3, 2, 10, 0.6);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
    flex-wrap: wrap;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  .punto {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--lila-300);
    box-shadow: 0 0 12px 2px rgba(190, 150, 255, 0.8);
  }
  .nav ul {
    display: flex;
    align-items: center;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .nav ul a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s, text-shadow 0.2s;
  }
  .nav ul a:hover {
    color: var(--text);
    text-shadow: 0 0 14px rgba(185, 166, 255, 0.8);
  }
  /* selector de idioma: ES / EN, el actual resaltado */
  .nav ul a.idioma {
    display: inline-flex;
    gap: 4px;
    padding: 3px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .idioma .activo {
    color: var(--lila-300);
  }
  .barra-idioma {
    opacity: 0.5;
  }
  .pie {
    border-top: 1px solid var(--border);
    padding: 32px 0;
    font-size: 0.9rem;
  }
  @media (max-width: 560px) {
    .nav {
      padding-top: 10px;
      padding-bottom: 10px;
    }
    .nav {
      position: relative;
    }
    .nav ul {
      gap: 14px;
    }
    /* en móvil el selector ES / EN va arriba a la derecha, junto al nombre */
    .nav ul li:last-child {
      position: absolute;
      right: 20px;
      top: 10px;
    }
  }
</style>
