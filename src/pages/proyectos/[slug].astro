---
import Base from '../../layouts/Base.astro';
import { proyectos, type Proyecto } from '../../data/proyectos';

export function getStaticPaths() {
  return proyectos.map((p, i) => ({
    params: { slug: p.slug },
    props: { proyecto: p, siguiente: proyectos[(i + 1) % proyectos.length] },
  }));
}

interface Props {
  proyecto: Proyecto;
  siguiente: Proyecto;
}

const { proyecto, siguiente } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bloques = [
  { id: 'problema', titulo: 'El problema', parrafos: proyecto.problema },
  { id: 'que-hice', titulo: 'Qué hice', parrafos: proyecto.queHice },
  { id: 'resultado', titulo: 'Resultado', parrafos: proyecto.resultado },
];
---

<Base titulo={proyecto.titulo} descripcion={proyecto.resumen}>
  <article class="contenedor detalle">
    <a class="volver" href={`${base}/#proyectos`}>← Todos los casos</a>
    <p class="eyebrow">Caso de estudio</p>
    <h1>{proyecto.titulo}</h1>
    <p class="muted bajada">{proyecto.resumen}</p>
    <ul class="chips">
      {proyecto.etiquetas.map((e) => <li class="chip">{e}</li>)}
    </ul>

    {
      bloques.map((b, i) => (
        <section id={b.id} class="bloque" aria-labelledby={`${b.id}-titulo`}>
          <h2 id={`${b.id}-titulo`}>
            <span class="paso" aria-hidden="true">
              {i + 1}
            </span>
            {b.titulo}
          </h2>
          {b.id === 'problema' ? (
            b.parrafos.map((p) => <p>{p}</p>)
          ) : (
            <ul>
              {b.parrafos.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    <nav class="siguiente" aria-label="Siguiente caso">
      <span class="muted">Siguiente caso</span>
      <a href={`${base}/proyectos/${siguiente.slug}/`}>{siguiente.titulo} →</a>
    </nav>
  </article>
</Base>

<style>
  .detalle {
    max-width: 760px;
    padding-top: 48px;
    padding-bottom: 72px;
  }
  .volver {
    display: inline-block;
    margin-bottom: 2rem;
    text-decoration: none;
    font-weight: 600;
  }
  h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    margin: 0 0 1rem;
  }
  .bajada {
    font-size: 1.15rem;
  }
  .bloque {
    margin-top: 3rem;
  }
  .bloque h2 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }
  .paso {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.95rem;
    flex: none;
  }
  .bloque ul {
    padding-left: 1.2rem;
    display: grid;
    gap: 10px;
  }
  .siguiente {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .siguiente a {
    font-weight: 600;
    font-size: 1.1rem;
  }
</style>
