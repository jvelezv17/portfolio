---
import CasoEstudio from '../../components/CasoEstudio.astro';
import { proyectos } from '../../data/proyectos';
import { proyectos as proyectosEn } from '../../data/en/proyectos';

export function getStaticPaths() {
  return proyectos.map((p, i) => ({
    params: { slug: p.slug },
    props: { proyecto: p, siguiente: proyectos[(i + 1) % proyectos.length], equivalente: proyectosEn[i] },
  }));
}

const { proyecto, siguiente, equivalente } = Astro.props;
---

<CasoEstudio idioma="es" proyecto={proyecto} siguiente={siguiente} equivalente={equivalente} />
