---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cintas from '../components/Cintas.astro';
import Icono from '../components/Icono.astro';
import avatar from '../assets/avatar.png';
import { perfil, formacion, idiomas, proyectosPersonales, cifras } from '../data/perfil';
import { proyectos } from '../data/proyectos';
import { experiencia } from '../data/experiencia';
import { stack, formaDeTrabajo } from '../data/stack';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base>
  <section class="hero" aria-labelledby="hero-titulo">
    <Cintas />
    <div class="contenedor hero-grid">
      <div class="hero-texto">
        <p class="eyebrow">{perfil.rol}</p>
        <h1 id="hero-titulo" class="degradado">{perfil.nombre}</h1>
        <p class="frase">{perfil.frase}</p>
        <p class="muted resumen">{perfil.resumen}</p>
        <div class="acciones">
          <a class="boton primario" href="#proyectos">Ver casos de estudio</a>
          <a class="boton" href="#contacto">Contactarme</a>
          {perfil.cv && <a class="boton" href={perfil.cv} download>Descargar CV</a>}
        </div>
      </div>

      <div class="hero-avatar">
        <div class="anillo">
          <Image
            src={avatar}
            alt={`Avatar de ${perfil.nombre}`}
            width={320}
            height={352}
            loading="eager"
            class="foto"
          />
        </div>
        <div class="terminal vidrio" aria-label="Resultado de las pruebas de este sitio">
          <p><span class="prompt">$</span> npx playwright test</p>
          <p class="ok">✓ todas las pruebas pasan</p>
        </div>
      </div>
    </div>

    <ul class="contenedor cifras">
      {
        cifras.map((c) => (
          <li class="vidrio">
            <strong class="degradado">{c.valor}</strong>
            <span class="muted">{c.texto}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="proyectos" class="seccion" aria-labelledby="proyectos-titulo">
    <div class="contenedor">
      <p class="eyebrow">Casos de estudio</p>
      <h2 id="proyectos-titulo">Problemas reales, cómo los resolví y qué cambió</h2>
      <p class="muted nota">
        Trabajo en una plataforma SaaS de HR-tech. Por confidencialidad, los casos se cuentan sin nombres de la
        empresa ni de sus clientes, y sin código ni datos reales.
      </p>
      <ul class="tarjetas">
        {
          proyectos.map((p, i) => (
            <li class="tarjeta vidrio revelar" data-testid="tarjeta-proyecto">
              <span class="numero" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>
                <a href={`${base}/proyectos/${p.slug}/`}>{p.titulo}</a>
              </h3>
              <p class="muted">{p.resumen}</p>
              <ul class="chips">
                {p.etiquetas.map((e) => (
                  <li class="chip">{e}</li>
                ))}
              </ul>
              <span class="leer" aria-hidden="true">
                Leer caso →
              </span>
            </li>
          ))
        }
      </ul>

      <h3 class="subtitulo">Proyectos propios</h3>
      <ul class="tarjetas">
        {
          proyectosPersonales.map((p) => (
            <li class="tarjeta vidrio revelar">
              <h4>
                <a href={p.url} target="_blank" rel="noopener noreferrer">
                  {p.nombre} <span aria-hidden="true">↗</span>
                </a>
              </h4>
              <p class="muted">{p.descripcion}</p>
              <ul class="chips">
                {p.tecnologias.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="experiencia" class="seccion" aria-labelledby="experiencia-titulo">
    <div class="contenedor">
      <p class="eyebrow">Trayectoria</p>
      <h2 id="experiencia-titulo">Experiencia</h2>
      <ol class="linea">
        {
          experiencia.map((t, i) => (
            <li class:list={['hito', 'revelar', { actual: i === 0 }]} data-testid="trabajo">
              <div class="vidrio caja">
                <p class="fechas">
                  {t.desde} – {t.hasta}
                </p>
                <h3>{t.rol}</h3>
                <p class="empresa">{t.empresa}</p>
                <ul>
                  {t.logros.map((l) => (
                    <li>{l}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="dos-columnas">
        <div class="vidrio caja revelar">
          <h3 class="subtitulo-chico">Formación</h3>
          <ul class="lista-simple">
            {
              formacion.map((f) => (
                <li>
                  <strong>{f.titulo}</strong>
                  <br />
                  <span class="muted">
                    {f.lugar} · {f.fechas}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="vidrio caja revelar">
          <h3 class="subtitulo-chico">Idiomas</h3>
          <ul class="lista-simple">
            {idiomas.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="stack" class="seccion" aria-labelledby="stack-titulo">
    <div class="contenedor">
      <p class="eyebrow">Herramientas</p>
      <h2 id="stack-titulo">Stack</h2>
      <div class="stack">
        {
          stack.map((g) => (
            <div class="grupo revelar">
              <h3>{g.grupo}</h3>
              <ul class="iconos">
                {g.items.map((t) => (
                  <li class="tec vidrio" data-testid="tecnologia">
                    <Icono slug={t.icono} nombre={t.nombre} mono={t.mono} color={t.color} />
                    <span>{t.nombre}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="forma revelar">
        <h3>Forma de trabajo</h3>
        <ul class="chips">
          {formaDeTrabajo.map((f) => <li class="chip">{f}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="contacto" class="seccion" aria-labelledby="contacto-titulo">
    <div class="contenedor">
      <div class="panel-contacto vidrio revelar">
        <!--
          Tiempos de la animación (en ms), medidos cuadro por cuadro en public/avatar/contacto.webp:
          bucle completo 2666, la voltereta va de 266 a 1100. Si cambias el WebP, actualízalos.
        -->
        <div class="mascota" data-mascota data-bucle="2666" data-vuelta-desde="266" data-vuelta-hasta="1100">
          <div class="globo" aria-hidden="true" data-testid="globo-contacto">
            <span class="remolino">🌪️</span>
            <span class="torbellino"><i></i><i></i><i></i><i></i><i></i><i></i></span>
            <p class="globo-cuerpo">
              <span class="globo-texto" data-frase="¡Hablemos!">¡Hablemos!</span><span class="cursor"></span>
            </p>
          </div>
          <picture>
            <source media="(prefers-reduced-motion: reduce)" srcset={`${base}/avatar/contacto-quieto.webp`} />
            <img
              src={`${base}/avatar/contacto.webp`}
              alt={`Avatar de ${perfil.nombre} celebrando`}
              width="352"
              height="512"
              loading="lazy"
              decoding="async"
              data-testid="mascota-contacto"
            />
          </picture>
          <span class="pedestal" aria-hidden="true"></span>
        </div>
        <div class="contacto-texto">
        <p class="eyebrow">Hablemos</p>
        <h2 id="contacto-titulo">Contacto</h2>
        <p class="muted">¿Buscas a alguien que automatice tus pruebas o que arme un área de QA? Escríbeme.</p>
        <div class="acciones">
          {perfil.email && <a class="boton primario" href={`mailto:${perfil.email}`}>{perfil.email}</a>}
          {
            perfil.linkedin && (
              <a class="boton" href={perfil.linkedin} target="_blank" rel="noopener noreferrer">
                LinkedIn
              </a>
            )
          }
          {
            perfil.github && (
              <a class="boton" href={perfil.github} target="_blank" rel="noopener noreferrer">
                <Icono slug="siGithub" nombre="GitHub" tamano={18} />
                GitHub
              </a>
            )
          }
        </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Globo de chat del avatar de Contacto:
  // 1. primera voltereta al entrar a Contacto: aparece un torbellino 🌪️ donde va el globo;
  // 2. al terminar la voltereta, el torbellino se recoge, sale el globo girando y
  //    "¡Hablemos!" se escribe letra por letra, como en un chat;
  // 3. en las siguientes volteretas, el globo solo da una vuelta.
  // Para que todo coincida con la voltereta, la animación del WebP se reinicia desde el
  // cuadro 0 cada vez que Contacto aparece, y desde ahí se cuenta el tiempo.
  const esperar = (ms: number) => new Promise((r) => setTimeout(r, ms));

  const mascota = document.querySelector<HTMLElement>('[data-mascota]');
  const img = mascota?.querySelector('img');
  const globo = mascota?.querySelector<HTMLElement>('.globo');
  const cuerpo = globo?.querySelector<HTMLElement>('.globo-cuerpo');
  const texto = globo?.querySelector<HTMLElement>('.globo-texto');
  const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (mascota && img && globo && cuerpo && texto && !sinMovimiento) {
    const frase = texto.dataset.frase ?? texto.textContent ?? '';
    const bucle = Number(mascota.dataset.bucle);
    const desde = Number(mascota.dataset.vueltaDesde);
    const hasta = Number(mascota.dataset.vueltaHasta);
    globo.style.setProperty('--duracion-vuelta', `${hasta - desde}ms`);

    texto.textContent = '';
    globo.classList.add('oculto');

    let estado: 'nuevo' | 'intro' | 'listo' = 'nuevo';
    let t0 = 0;
    let relojListo = false; // true cuando t0 ya corresponde al cuadro 0 del avatar
    let ultimoCiclo = -1;
    let raf = 0;
    let archivo: Blob | undefined;
    const origen = img.src;

    // torbellino durante la voltereta → globo → texto letra por letra
    async function intro() {
      estado = 'intro';
      globo!.classList.add('torbellino-activo');
      await esperar(hasta - desde);
      globo!.classList.remove('torbellino-activo', 'oculto');
      globo!.classList.add('aparece');
      await esperar(160);
      globo!.classList.add('tecleando');
      const letras = [...frase];
      for (let i = 0; i < letras.length; i++) {
        texto!.textContent += letras[i];
        if (i === letras.length - 1) break;
        // ritmo humano: irregular, un poco más lento al empezar y antes del signo final.
        // Tiene que terminar antes de la siguiente voltereta (~1,6 s después de salir el globo).
        let pausa = 55 + Math.random() * 65;
        if (i === 0) pausa += 110;
        if (i === letras.length - 2) pausa += 90;
        await esperar(pausa);
      }
      estado = 'listo';
      await esperar(500);
      globo!.classList.remove('tecleando', 'aparece');
    }

    // Reinicia el WebP en el cuadro 0 usando una URL nueva (blob) del mismo archivo.
    async function reiniciarAvatar() {
      relojListo = false;
      try {
        archivo ??= await fetch(origen).then((r) => r.blob());
        const url = URL.createObjectURL(archivo);
        const nueva = new Image();
        nueva.src = url;
        await nueva.decode();
        const anterior = img!.src;
        img!.src = url;
        requestAnimationFrame(() => {
          t0 = performance.now();
          ultimoCiclo = -1;
          relojListo = true;
        });
        if (anterior.startsWith('blob:')) URL.revokeObjectURL(anterior);
      } catch {
        t0 = performance.now(); // si algo falla, el avatar sigue animado igual
        relojListo = true;
      }
    }

    cuerpo.addEventListener('animationend', () => {
      cuerpo.classList.remove('gira');
      globo.classList.remove('girando');
    });

    function girar() {
      cuerpo!.classList.remove('gira');
      globo!.classList.remove('girando');
      void cuerpo!.offsetWidth; // reinicia la animación CSS
      cuerpo!.classList.add('gira');
      globo!.classList.add('girando');
    }

    function vigilar() {
      const transcurrido = performance.now() - t0;
      const ciclo = Math.floor(transcurrido / bucle);
      const fase = transcurrido % bucle;
      // actúa solo justo cuando empieza una voltereta (no a mitad de ella)
      if (relojListo && ciclo !== ultimoCiclo && fase >= desde && fase < desde + 120) {
        ultimoCiclo = ciclo;
        if (estado === 'nuevo') intro();
        else if (estado === 'listo') girar();
      }
      raf = requestAnimationFrame(vigilar);
    }

    new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            reiniciarAvatar();
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(vigilar);
          } else {
            cancelAnimationFrame(raf);
          }
        }
      },
      { threshold: 0.4 },
    ).observe(mascota);
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: 110px 0 40px;
    overflow: hidden;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
    gap: 48px;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    margin: 0 0 1.1rem;
  }
  .frase {
    font-size: clamp(1.2rem, 2.6vw, 1.55rem);
    max-width: 30ch;
    margin: 0 0 1rem;
    font-weight: 500;
  }
  .resumen {
    max-width: 58ch;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 1.75rem;
  }
  .hero-avatar {
    position: relative;
    justify-self: center;
    width: min(100%, 340px);
  }
  .anillo {
    position: relative;
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 6px;
    background: conic-gradient(from 200deg, #3b1fb8, #b9a6ff, #d8b4fe, #6d4aff, #3b1fb8);
    box-shadow:
      0 0 60px rgba(124, 92, 255, 0.55),
      0 0 140px rgba(124, 92, 255, 0.25);
    animation: girar-brillo 8s linear infinite;
  }
  .anillo::after {
    content: '';
    position: absolute;
    inset: -18px;
    border-radius: 50%;
    border: 1px solid rgba(185, 166, 255, 0.25);
  }
  .foto {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    border-radius: 50%;
    background: var(--surface-solid);
  }
  @keyframes girar-brillo {
    50% {
      box-shadow:
        0 0 80px rgba(160, 120, 255, 0.7),
        0 0 170px rgba(124, 92, 255, 0.3);
    }
  }
  .terminal {
    position: absolute;
    left: -36px;
    bottom: -8px;
    padding: 10px 16px;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.8rem;
    line-height: 1.5;
    border-radius: 12px;
    animation: flotar-y 6s ease-in-out infinite alternate;
  }
  .terminal p {
    margin: 0;
  }
  .prompt {
    color: var(--violeta-300);
  }
  .ok {
    color: #7ee2b8;
  }
  @keyframes flotar-y {
    to {
      transform: translateY(-10px);
    }
  }
  .cifras {
    position: relative;
    z-index: 1;
    list-style: none;
    margin-top: 72px;
    margin-bottom: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 14px;
  }
  .cifras li {
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
  }
  .cifras strong {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 2rem;
    line-height: 1.1;
  }

  /* ---------- Tarjetas ---------- */
  .nota {
    max-width: 70ch;
  }
  .tarjetas {
    list-style: none;
    padding: 0;
    margin: 2.25rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 18px;
  }
  .tarjeta {
    position: relative;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition:
      border-color 0.25s,
      transform 0.25s,
      box-shadow 0.25s;
  }
  .tarjeta::before {
    /* borde con degradado que se enciende al pasar el mouse */
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, var(--lila-300), transparent 40%, transparent 60%, var(--violeta-500));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
  }
  .tarjeta:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 50px rgba(80, 50, 200, 0.35);
  }
  .tarjeta:hover::before {
    opacity: 1;
  }
  .numero {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--violeta-300);
    letter-spacing: 0.1em;
  }
  .tarjeta h3,
  .tarjeta h4 {
    margin: 0;
    font-size: 1.2rem;
  }
  .tarjeta h3 a,
  .tarjeta h4 a {
    color: var(--text);
    text-decoration: none;
  }
  .tarjeta h3 a::after,
  .tarjeta h4 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .tarjeta p {
    margin: 0;
    flex: 1;
  }
  .leer {
    color: var(--violeta-300);
    font-weight: 600;
    font-size: 0.9rem;
    transition: transform 0.25s;
  }
  .tarjeta:hover .leer {
    transform: translateX(4px);
  }
  .subtitulo {
    margin: 3.5rem 0 0;
    font-size: 1.3rem;
  }

  /* ---------- Línea de tiempo ---------- */
  .linea {
    position: relative;
    list-style: none;
    padding: 0 0 0 34px;
    margin: 2rem 0 0;
  }
  .linea::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(to bottom, var(--lila-300), var(--violeta-500) 40%, rgba(109, 74, 255, 0.1));
    box-shadow: 0 0 12px rgba(124, 92, 255, 0.6);
  }
  .hito {
    position: relative;
    padding-bottom: 20px;
  }
  .hito::before {
    content: '';
    position: absolute;
    left: -32px;
    top: 26px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--violeta-300);
  }
  .hito.actual::before {
    background: var(--lila-300);
    box-shadow: 0 0 16px 4px rgba(190, 150, 255, 0.75);
  }
  .caja {
    padding: 22px 24px;
  }
  .hito h3 {
    margin: 0.2rem 0 0;
    font-size: 1.25rem;
  }
  .fechas {
    margin: 0;
    font-size: 0.82rem;
    color: var(--muted);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .empresa {
    margin: 0 0 0.6rem;
    color: var(--violeta-300);
    font-weight: 600;
  }
  .hito ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 4px;
  }
  .dos-columnas {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 18px;
  }
  .subtitulo-chico {
    margin: 0;
    font-size: 1.15rem;
  }
  .lista-simple {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 12px;
  }

  /* ---------- Stack ---------- */
  .stack {
    display: grid;
    gap: 34px;
    margin-top: 2rem;
  }
  .grupo h3,
  .forma h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin: 0 0 0.9rem;
  }
  .iconos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
    gap: 12px;
  }
  .tec {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 14px;
    color: var(--violeta-300);
    transition:
      color 0.2s,
      border-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }
  .tec span {
    color: var(--text);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .tec:hover {
    color: var(--lila-300);
    border-color: var(--border-strong);
    box-shadow: var(--glow);
    transform: translateY(-2px);
  }
  .forma {
    margin-top: 34px;
  }

  /* ---------- Contacto ---------- */
  .panel-contacto {
    position: relative;
    display: grid;
    grid-template-columns: minmax(200px, 300px) 1fr;
    align-items: center;
    gap: clamp(20px, 5vw, 56px);
    padding: clamp(28px, 5vw, 48px) clamp(24px, 6vw, 64px);
    background:
      radial-gradient(420px 320px at 18% 70%, rgba(124, 92, 255, 0.4), transparent 70%),
      radial-gradient(600px 260px at 80% 0%, rgba(124, 92, 255, 0.18), transparent 70%),
      var(--surface);
  }
  .contacto-texto h2 {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  /* Avatar animado parado sobre un "pedestal" de luz */
  .mascota {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 280px;
    padding-top: 28px;
  }
  .mascota img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 24px rgba(60, 30, 180, 0.55));
  }
  .pedestal {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -6px;
    height: 34px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(200, 170, 255, 0.85), rgba(109, 74, 255, 0.45) 55%, transparent);
    filter: blur(4px);
    animation: latir-pedestal 2.7s ease-in-out infinite;
  }
  @keyframes latir-pedestal {
    50% {
      opacity: 0.6;
      transform: scaleX(0.9);
    }
  }
  /* ---------- Globo de chat ---------- */
  /* .globo flota; .globo-cuerpo es lo que gira (así las dos animaciones no se pisan).
     Va anclado por la derecha: al escribir crece hacia la izquierda y la colita
     sigue apuntando a la mano levantada. */
  .globo {
    position: absolute;
    z-index: 2;
    top: 34%;
    right: 72%;
    animation: flotar-y 3s ease-in-out infinite alternate;
  }
  .globo-cuerpo {
    position: relative;
    margin: 0;
    padding: 7px 14px;
    min-height: 2.1em;
    display: flex;
    align-items: center;
    white-space: nowrap;
    border-radius: 16px;
    background: linear-gradient(100deg, var(--violeta-300), var(--lila-300));
    color: #0b0620;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    box-shadow: 0 6px 24px rgba(140, 100, 255, 0.45);
    transform-origin: 50% 50%;
  }
  /* colita, apuntando hacia la mano levantada */
  .globo-cuerpo::after {
    content: '';
    position: absolute;
    right: 10px;
    bottom: -9px;
    width: 18px;
    height: 12px;
    background: var(--lila-300);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
  }

  /* Estado inicial con JS: globo escondido hasta que Contacto entra en pantalla */
  .globo.oculto .globo-cuerpo {
    visibility: hidden;
    opacity: 0;
  }
  /* el globo "sale" del torbellino: gira y se infla con un rebote */
  .globo.aparece .globo-cuerpo {
    animation: salir-del-torbellino 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes salir-del-torbellino {
    from {
      transform: rotate(-300deg) scale(0.15);
      opacity: 0;
      filter: blur(3px);
    }
    60% {
      opacity: 1;
      filter: blur(0);
    }
  }

  /* Torbellino: anillos apilados que se mecen desfasados, más anchos arriba (embudo).
     Solo se ve durante la primera voltereta; luego se recoge y deja el globo. */
  .torbellino {
    position: absolute;
    right: 6px;
    bottom: 0;
    width: 124px;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    pointer-events: none;
    filter: drop-shadow(0 0 8px rgba(185, 150, 255, 0.9));
    transform-origin: 50% 100%;
  }
  .globo.torbellino-activo .torbellino {
    display: flex;
    animation: torbellino-vida var(--duracion-vuelta, 834ms) ease-in-out forwards;
  }
  .torbellino i {
    display: block;
    height: 14px;
    border-radius: 50%;
    border: 3.5px solid var(--lila-300);
    border-top-color: rgba(255, 255, 255, 0.9);
    border-bottom-color: var(--violeta-500);
    animation: mecer-anillo 0.32s ease-in-out infinite alternate;
  }
  .torbellino i:nth-child(1) { width: 124px; animation-delay: 0s; }
  .torbellino i:nth-child(2) { width: 100px; animation-delay: -0.08s; }
  .torbellino i:nth-child(3) { width: 78px; animation-delay: -0.16s; }
  .torbellino i:nth-child(4) { width: 58px; animation-delay: -0.24s; }
  .torbellino i:nth-child(5) { width: 40px; animation-delay: -0.32s; }
  .torbellino i:nth-child(6) { width: 22px; animation-delay: -0.4s; }
  @keyframes mecer-anillo {
    from {
      transform: translateX(-7px) rotate(-4deg);
    }
    to {
      transform: translateX(7px) rotate(4deg);
    }
  }
  @keyframes torbellino-vida {
    0% {
      opacity: 0;
      transform: scale(0.2, 0.1) rotate(-20deg);
    }
    20% {
      opacity: 1;
      transform: scale(1, 1) rotate(6deg);
    }
    70% {
      opacity: 1;
      transform: scale(1.05, 1) rotate(-6deg);
    }
    100% {
      /* se recoge hacia donde aparece el globo */
      opacity: 0;
      transform: scale(0.3, 0.15) translateY(-20px) rotate(10deg);
    }
  }

  /* cursor que parpadea mientras escribe y se apaga al terminar */
  .cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 2px;
    background: #0b0620;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .globo.tecleando .cursor {
    opacity: 1;
    animation: parpadeo 0.9s steps(1) infinite;
  }
  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  /* Remolino: el globo da una vuelta mientras el avatar hace la voltereta */
  .globo:not(.oculto) .globo-cuerpo.gira {
    animation: remolino-globo var(--duracion-vuelta, 834ms) cubic-bezier(0.45, 0, 0.3, 1);
  }
  @keyframes remolino-globo {
    0% {
      transform: rotate(0) scale(1);
    }
    15% {
      transform: translate(-6px, 0) rotate(-18deg) scale(0.9);
    }
    55% {
      /* se corre a la izquierda: en la voltereta la cabeza del avatar invade este espacio */
      transform: translate(-34px, -8px) rotate(250deg) scale(0.72);
      filter: blur(0.6px);
    }
    85% {
      transform: translate(-8px, 0) rotate(372deg) scale(0.97);
    }
    100% {
      transform: rotate(360deg) scale(1);
    }
  }
  .remolino {
    position: absolute;
    left: -14px;
    top: -18px;
    font-size: 1.5rem;
    opacity: 0;
    pointer-events: none;
  }
  .globo.girando .remolino {
    animation: remolino-emoji var(--duracion-vuelta, 834ms) ease-out;
  }
  @keyframes remolino-emoji {
    0% {
      opacity: 0;
      transform: translate(10px, 10px) scale(0.3) rotate(0);
    }
    30% {
      opacity: 1;
      transform: translate(0, 0) scale(1.1) rotate(-120deg);
    }
    75% {
      opacity: 1;
      transform: translate(-6px, -10px) scale(1) rotate(-300deg);
    }
    100% {
      opacity: 0;
      transform: translate(-12px, -22px) scale(0.6) rotate(-400deg);
    }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 820px) {
    .hero {
      padding-top: 64px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-avatar {
      order: -1;
      width: min(70%, 240px);
    }
    .terminal {
      left: auto;
      right: -20px;
      bottom: -14px;
      font-size: 0.72rem;
    }
    .panel-contacto {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .panel-contacto .eyebrow,
    .panel-contacto .acciones {
      justify-content: center;
    }
    .mascota {
      max-width: 200px;
    }
  }
</style>
