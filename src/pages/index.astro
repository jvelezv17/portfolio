---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cintas from '../components/Cintas.astro';
import Icono from '../components/Icono.astro';
import avatar from '../assets/avatar.png';
import { perfil, formacion, idiomas, proyectosPersonales, cifras } from '../data/perfil';
import { proyectos } from '../data/proyectos';
import { experiencia } from '../data/experiencia';
import { stack, formaDeTrabajo } from '../data/stack';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base>
  <section class="hero" aria-labelledby="hero-titulo">
    <Cintas />
    <div class="contenedor hero-grid">
      <div class="hero-texto">
        <p class="eyebrow">{perfil.rol}</p>
        <h1 id="hero-titulo" class="degradado">{perfil.nombre}</h1>
        <p class="frase">{perfil.frase}</p>
        <p class="muted resumen">{perfil.resumen}</p>
        <div class="acciones">
          <a class="boton primario" href="#proyectos">Ver casos de estudio</a>
          <a class="boton" href="#contacto">Contactarme</a>
          {perfil.cv && <a class="boton" href={perfil.cv} download>Descargar CV</a>}
        </div>
      </div>

      <div class="hero-avatar">
        <div class="anillo">
          <Image
            src={avatar}
            alt={`Avatar de ${perfil.nombre}`}
            width={320}
            height={352}
            loading="eager"
            class="foto"
          />
        </div>
        <div class="terminal vidrio" aria-label="Resultado de las pruebas de este sitio">
          <p><span class="prompt">$</span> npx playwright test</p>
          <p class="ok">✓ todas las pruebas pasan</p>
        </div>
      </div>
    </div>

    <ul class="contenedor cifras">
      {
        cifras.map((c) => (
          <li class="vidrio">
            <strong class="degradado">{c.valor}</strong>
            <span class="muted">{c.texto}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="proyectos" class="seccion" aria-labelledby="proyectos-titulo">
    <div class="contenedor">
      <p class="eyebrow">Casos de estudio</p>
      <h2 id="proyectos-titulo">Problemas reales, cómo los resolví y qué cambió</h2>
      <p class="muted nota">
        Trabajo en una plataforma SaaS de HR-tech. Por confidencialidad, los casos se cuentan sin nombres de la
        empresa ni de sus clientes, y sin código ni datos reales.
      </p>
      <ul class="tarjetas">
        {
          proyectos.map((p, i) => (
            <li class="tarjeta vidrio revelar" data-testid="tarjeta-proyecto">
              <span class="numero" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>
                <a href={`${base}/proyectos/${p.slug}/`}>{p.titulo}</a>
              </h3>
              <p class="muted">{p.resumen}</p>
              <ul class="chips">
                {p.etiquetas.map((e) => (
                  <li class="chip">{e}</li>
                ))}
              </ul>
              <span class="leer" aria-hidden="true">
                Leer caso →
              </span>
            </li>
          ))
        }
      </ul>

      <h3 class="subtitulo">Proyectos propios</h3>
      <ul class="tarjetas">
        {
          proyectosPersonales.map((p) => (
            <li class="tarjeta vidrio revelar">
              <h4>
                <a href={p.url} target="_blank" rel="noopener noreferrer">
                  {p.nombre} <span aria-hidden="true">↗</span>
                </a>
              </h4>
              <p class="muted">{p.descripcion}</p>
              <ul class="chips">
                {p.tecnologias.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="experiencia" class="seccion" aria-labelledby="experiencia-titulo">
    <div class="contenedor">
      <p class="eyebrow">Trayectoria</p>
      <h2 id="experiencia-titulo">Experiencia</h2>
      <ol class="linea">
        {
          experiencia.map((t, i) => (
            <li class:list={['hito', 'revelar', { actual: i === 0 }]} data-testid="trabajo">
              <div class="vidrio caja">
                <p class="fechas">
                  {t.desde} – {t.hasta}
                </p>
                <h3>{t.rol}</h3>
                <p class="empresa">{t.empresa}</p>
                <ul>
                  {t.logros.map((l) => (
                    <li>{l}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="dos-columnas">
        <div class="vidrio caja revelar">
          <h3 class="subtitulo-chico">Formación</h3>
          <ul class="lista-simple">
            {
              formacion.map((f) => (
                <li>
                  <strong>{f.titulo}</strong>
                  <br />
                  <span class="muted">
                    {f.lugar} · {f.fechas}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="vidrio caja revelar">
          <h3 class="subtitulo-chico">Idiomas</h3>
          <ul class="lista-simple">
            {idiomas.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="stack" class="seccion" aria-labelledby="stack-titulo">
    <div class="contenedor">
      <p class="eyebrow">Herramientas</p>
      <h2 id="stack-titulo">Stack</h2>
      <div class="stack">
        {
          stack.map((g) => (
            <div class="grupo revelar">
              <h3>{g.grupo}</h3>
              <ul class="iconos">
                {g.items.map((t) => (
                  <li class="tec vidrio" data-testid="tecnologia">
                    <Icono slug={t.icono} nombre={t.nombre} mono={t.mono} color={t.color} />
                    <span>{t.nombre}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="forma revelar">
        <h3>Forma de trabajo</h3>
        <ul class="chips">
          {formaDeTrabajo.map((f) => <li class="chip">{f}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="contacto" class="seccion" aria-labelledby="contacto-titulo">
    <div class="contenedor">
      <div class="panel-contacto vidrio revelar">
        <div class="mascota">
          <p class="globo" aria-hidden="true">¡Hablemos!</p>
          <picture>
            <source media="(prefers-reduced-motion: reduce)" srcset={`${base}/avatar/contacto-quieto.webp`} />
            <img
              src={`${base}/avatar/contacto.webp`}
              alt={`Avatar de ${perfil.nombre} celebrando`}
              width="352"
              height="512"
              loading="lazy"
              decoding="async"
              data-testid="mascota-contacto"
            />
          </picture>
          <span class="pedestal" aria-hidden="true"></span>
        </div>
        <div class="contacto-texto">
        <p class="eyebrow">Hablemos</p>
        <h2 id="contacto-titulo">Contacto</h2>
        <p class="muted">¿Buscas a alguien que automatice tus pruebas o que arme un área de QA? Escríbeme.</p>
        <div class="acciones">
          {perfil.email && <a class="boton primario" href={`mailto:${perfil.email}`}>{perfil.email}</a>}
          {
            perfil.linkedin && (
              <a class="boton" href={perfil.linkedin} target="_blank" rel="noopener noreferrer">
                LinkedIn
              </a>
            )
          }
          {
            perfil.github && (
              <a class="boton" href={perfil.github} target="_blank" rel="noopener noreferrer">
                <Icono slug="siGithub" nombre="GitHub" tamano={18} />
                GitHub
              </a>
            )
          }
        </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: 110px 0 40px;
    overflow: hidden;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
    gap: 48px;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    margin: 0 0 1.1rem;
  }
  .frase {
    font-size: clamp(1.2rem, 2.6vw, 1.55rem);
    max-width: 30ch;
    margin: 0 0 1rem;
    font-weight: 500;
  }
  .resumen {
    max-width: 58ch;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 1.75rem;
  }
  .hero-avatar {
    position: relative;
    justify-self: center;
    width: min(100%, 340px);
  }
  .anillo {
    position: relative;
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 6px;
    background: conic-gradient(from 200deg, #3b1fb8, #b9a6ff, #d8b4fe, #6d4aff, #3b1fb8);
    box-shadow:
      0 0 60px rgba(124, 92, 255, 0.55),
      0 0 140px rgba(124, 92, 255, 0.25);
    animation: girar-brillo 8s linear infinite;
  }
  .anillo::after {
    content: '';
    position: absolute;
    inset: -18px;
    border-radius: 50%;
    border: 1px solid rgba(185, 166, 255, 0.25);
  }
  .foto {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    border-radius: 50%;
    background: var(--surface-solid);
  }
  @keyframes girar-brillo {
    50% {
      box-shadow:
        0 0 80px rgba(160, 120, 255, 0.7),
        0 0 170px rgba(124, 92, 255, 0.3);
    }
  }
  .terminal {
    position: absolute;
    left: -36px;
    bottom: -8px;
    padding: 10px 16px;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.8rem;
    line-height: 1.5;
    border-radius: 12px;
    animation: flotar-y 6s ease-in-out infinite alternate;
  }
  .terminal p {
    margin: 0;
  }
  .prompt {
    color: var(--violeta-300);
  }
  .ok {
    color: #7ee2b8;
  }
  @keyframes flotar-y {
    to {
      transform: translateY(-10px);
    }
  }
  .cifras {
    position: relative;
    z-index: 1;
    list-style: none;
    margin-top: 72px;
    margin-bottom: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 14px;
  }
  .cifras li {
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
  }
  .cifras strong {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 2rem;
    line-height: 1.1;
  }

  /* ---------- Tarjetas ---------- */
  .nota {
    max-width: 70ch;
  }
  .tarjetas {
    list-style: none;
    padding: 0;
    margin: 2.25rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 18px;
  }
  .tarjeta {
    position: relative;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition:
      border-color 0.25s,
      transform 0.25s,
      box-shadow 0.25s;
  }
  .tarjeta::before {
    /* borde con degradado que se enciende al pasar el mouse */
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, var(--lila-300), transparent 40%, transparent 60%, var(--violeta-500));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
  }
  .tarjeta:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 50px rgba(80, 50, 200, 0.35);
  }
  .tarjeta:hover::before {
    opacity: 1;
  }
  .numero {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--violeta-300);
    letter-spacing: 0.1em;
  }
  .tarjeta h3,
  .tarjeta h4 {
    margin: 0;
    font-size: 1.2rem;
  }
  .tarjeta h3 a,
  .tarjeta h4 a {
    color: var(--text);
    text-decoration: none;
  }
  .tarjeta h3 a::after,
  .tarjeta h4 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .tarjeta p {
    margin: 0;
    flex: 1;
  }
  .leer {
    color: var(--violeta-300);
    font-weight: 600;
    font-size: 0.9rem;
    transition: transform 0.25s;
  }
  .tarjeta:hover .leer {
    transform: translateX(4px);
  }
  .subtitulo {
    margin: 3.5rem 0 0;
    font-size: 1.3rem;
  }

  /* ---------- Línea de tiempo ---------- */
  .linea {
    position: relative;
    list-style: none;
    padding: 0 0 0 34px;
    margin: 2rem 0 0;
  }
  .linea::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(to bottom, var(--lila-300), var(--violeta-500) 40%, rgba(109, 74, 255, 0.1));
    box-shadow: 0 0 12px rgba(124, 92, 255, 0.6);
  }
  .hito {
    position: relative;
    padding-bottom: 20px;
  }
  .hito::before {
    content: '';
    position: absolute;
    left: -32px;
    top: 26px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--violeta-300);
  }
  .hito.actual::before {
    background: var(--lila-300);
    box-shadow: 0 0 16px 4px rgba(190, 150, 255, 0.75);
  }
  .caja {
    padding: 22px 24px;
  }
  .hito h3 {
    margin: 0.2rem 0 0;
    font-size: 1.25rem;
  }
  .fechas {
    margin: 0;
    font-size: 0.82rem;
    color: var(--muted);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .empresa {
    margin: 0 0 0.6rem;
    color: var(--violeta-300);
    font-weight: 600;
  }
  .hito ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 4px;
  }
  .dos-columnas {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 18px;
  }
  .subtitulo-chico {
    margin: 0;
    font-size: 1.15rem;
  }
  .lista-simple {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 12px;
  }

  /* ---------- Stack ---------- */
  .stack {
    display: grid;
    gap: 34px;
    margin-top: 2rem;
  }
  .grupo h3,
  .forma h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin: 0 0 0.9rem;
  }
  .iconos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
    gap: 12px;
  }
  .tec {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 14px;
    color: var(--violeta-300);
    transition:
      color 0.2s,
      border-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }
  .tec span {
    color: var(--text);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .tec:hover {
    color: var(--lila-300);
    border-color: var(--border-strong);
    box-shadow: var(--glow);
    transform: translateY(-2px);
  }
  .forma {
    margin-top: 34px;
  }

  /* ---------- Contacto ---------- */
  .panel-contacto {
    position: relative;
    display: grid;
    grid-template-columns: minmax(200px, 300px) 1fr;
    align-items: center;
    gap: clamp(20px, 5vw, 56px);
    padding: clamp(28px, 5vw, 48px) clamp(24px, 6vw, 64px);
    background:
      radial-gradient(420px 320px at 18% 70%, rgba(124, 92, 255, 0.4), transparent 70%),
      radial-gradient(600px 260px at 80% 0%, rgba(124, 92, 255, 0.18), transparent 70%),
      var(--surface);
  }
  .contacto-texto h2 {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  /* Avatar animado parado sobre un "pedestal" de luz */
  .mascota {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 280px;
    padding-top: 28px;
  }
  .mascota img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 24px rgba(60, 30, 180, 0.55));
  }
  .pedestal {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -6px;
    height: 34px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(200, 170, 255, 0.85), rgba(109, 74, 255, 0.45) 55%, transparent);
    filter: blur(4px);
    animation: latir-pedestal 2.7s ease-in-out infinite;
  }
  @keyframes latir-pedestal {
    50% {
      opacity: 0.6;
      transform: scaleX(0.9);
    }
  }
  .globo {
    position: absolute;
    z-index: 2;
    top: 0;
    right: -8px;
    margin: 0;
    padding: 6px 14px;
    border-radius: 14px 14px 14px 4px;
    background: linear-gradient(100deg, var(--violeta-300), var(--lila-300));
    color: #0b0620;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    box-shadow: 0 6px 24px rgba(140, 100, 255, 0.45);
    animation: flotar-y 3s ease-in-out infinite alternate;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 820px) {
    .hero {
      padding-top: 64px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-avatar {
      order: -1;
      width: min(70%, 240px);
    }
    .terminal {
      left: auto;
      right: -20px;
      bottom: -14px;
      font-size: 0.72rem;
    }
    .panel-contacto {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .panel-contacto .eyebrow,
    .panel-contacto .acciones {
      justify-content: center;
    }
    .mascota {
      max-width: 200px;
    }
  }
</style>
