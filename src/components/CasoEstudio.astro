---
// Página de detalle de un caso de estudio (problema → qué hice → resultado), en cualquier idioma.
// La usan src/pages/proyectos/[slug].astro (español) y src/pages/en/projects/[slug].astro (inglés).
import Base from '../layouts/Base.astro';
import type { Proyecto } from '../data/proyectos';
import { textos, rutas, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
  proyecto: Proyecto;
  siguiente: Proyecto;
  /** el mismo caso en el otro idioma */
  equivalente: Proyecto;
}

const { idioma, proyecto, siguiente, equivalente } = Astro.props;
const t = textos[idioma];
const otro: Idioma = idioma === 'es' ? 'en' : 'es';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const inicio = `${base}${rutas.inicio[idioma]}`;
const bloques = [
  { id: 'problema', titulo: t.problema, parrafos: proyecto.problema },
  { id: 'que-hice', titulo: t.queHice, parrafos: proyecto.queHice },
  { id: 'resultado', titulo: t.resultado, parrafos: proyecto.resultado },
];
---

<Base
  idioma={idioma}
  alterna={`${rutas.casos[otro]}${equivalente.slug}/`}
  titulo={proyecto.titulo}
  descripcion={proyecto.resumen}
>
  <article class="contenedor detalle">
    <a class="volver" href={`${inicio}#proyectos`}>{t.todosLosCasos}</a>
    <p class="eyebrow">{t.caso}</p>
    <h1 class="degradado">{proyecto.titulo}</h1>
    <p class="muted bajada">{proyecto.resumen}</p>
    <ul class="chips">
      {proyecto.etiquetas.map((e) => <li class="chip">{e}</li>)}
    </ul>

    {
      bloques.map((b, i) => (
        <section id={b.id} class="bloque vidrio" aria-labelledby={`${b.id}-titulo`}>
          <h2 id={`${b.id}-titulo`}>
            <span class="paso" aria-hidden="true">
              {i + 1}
            </span>
            {b.titulo}
          </h2>
          {b.id === 'problema' ? (
            b.parrafos.map((p) => <p>{p}</p>)
          ) : (
            <ul>
              {b.parrafos.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    <nav class="siguiente" aria-label={t.siguienteCaso}>
      <span class="muted">{t.siguienteCaso}</span>
      <a href={`${base}${rutas.casos[idioma]}${siguiente.slug}/`}>{siguiente.titulo} →</a>
    </nav>
  </article>
</Base>

<style>
  .detalle {
    max-width: 760px;
    padding-top: 48px;
    padding-bottom: 72px;
  }
  .volver {
    display: inline-block;
    margin-bottom: 2rem;
    text-decoration: none;
    font-weight: 600;
  }
  h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    margin: 0 0 1rem;
  }
  .bajada {
    font-size: 1.15rem;
  }
  .bloque {
    margin-top: 2rem;
    padding: clamp(20px, 4vw, 32px);
  }
  .bloque h2 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }
  .paso {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.95rem;
    flex: none;
  }
  .bloque ul {
    padding-left: 1.2rem;
    display: grid;
    gap: 10px;
  }
  .siguiente {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .siguiente a {
    font-weight: 600;
    font-size: 1.1rem;
  }
</style>
