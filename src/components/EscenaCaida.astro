---
// Avatar de Juan cayéndose delante de un "404" gigante. Lo usan la página 404 y la del easter egg.
// El texto de al lado va en el slot.
import Cintas from './Cintas.astro';
import { perfil } from '../data/perfil';
import type { Idioma } from '../i18n';

interface Props {
  idioma?: Idioma;
}
const { idioma = 'es' } = Astro.props;
const alt =
  idioma === 'en' ? `Avatar of ${perfil.nombre} falling over in surprise` : `Avatar de ${perfil.nombre} cayéndose sorprendido`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="vacio">
  <Cintas />
  <div class="contenedor rejilla">
    <div class="escena">
      <span class="numero" aria-hidden="true">404</span>
      <picture>
        <source media="(prefers-reduced-motion: reduce)" srcset={`${base}/avatar/404-quieto.webp`} />
        <img
          src={`${base}/avatar/404.webp`}
          alt={alt}
          width="370"
          height="454"
          decoding="async"
          data-testid="mascota-404"
        />
      </picture>
      <span class="sombra" aria-hidden="true"></span>
    </div>
    <div class="texto">
      <slot />
    </div>
  </div>
</section>

<style>
  .vacio {
    position: relative;
    overflow: hidden;
    min-height: calc(100vh - 160px);
    display: flex;
    align-items: center;
    padding: 64px 0;
  }
  .rejilla {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(220px, 380px) 1fr;
    align-items: center;
    gap: clamp(24px, 6vw, 72px);
  }
  .escena {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 340px;
  }
  /* el "404" gigante detrás del avatar */
  .numero {
    position: absolute;
    inset: 10% -20% auto;
    text-align: center;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(6rem, 18vw, 11rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(185, 166, 255, 0.35);
    text-shadow: 0 0 40px rgba(124, 92, 255, 0.35);
    user-select: none;
  }
  .escena img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
  }
  /* brillo fijo detrás (un drop-shadow sobre el WebP animado titila) */
  .escena::before {
    content: '';
    position: absolute;
    inset: 8% -4% 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(109, 74, 255, 0.4), rgba(59, 31, 184, 0.15) 60%, transparent);
    pointer-events: none;
  }
  .sombra {
    position: absolute;
    left: 8%;
    right: 30%;
    bottom: -4px;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(200, 170, 255, 0.7), rgba(109, 74, 255, 0.35) 55%, transparent);
    filter: blur(4px);
  }
  .texto :global(h1) {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    margin: 0 0 0.75rem;
  }
  .texto :global(.bajada) {
    font-size: 1.15rem;
    margin: 0 0 1.75rem;
  }
  @media (max-width: 760px) {
    .rejilla {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .escena {
      max-width: 240px;
    }
    .texto :global(.eyebrow) {
      justify-content: center;
    }
  }
</style>
