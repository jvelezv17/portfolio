---
// Easter egg: un bicho (bug) cruza la pantalla de vez en cuando.
// Huye si el mouse se le acerca; si lo atrapas, te lleva a /bug-encontrado/.
// Para verlo enseguida (o en las pruebas): agrega ?bicho a la URL.
import { textos, rutas, type Idioma } from '../i18n';

interface Props {
  idioma?: Idioma;
}
const { idioma = 'es' } = Astro.props;
const t = textos[idioma];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<button
  type="button"
  class="bicho"
  hidden
  aria-label={t.bicho}
  data-destino={`${base}${rutas.bugEncontrado[idioma]}`}
  data-testid="bicho"
>
  <span class="giro">
  <svg viewBox="0 0 40 52" width="34" height="44" aria-hidden="true">
    <!-- Colores con contraste: claro con borde oscuro, para que se vea sobre lo oscuro (fondo,
         pelo del avatar, violeta) y sobre lo claro (piel, botones). Antes era violeta oscuro y
         se camuflaba encima de la foto de perfil. -->
    <!-- patas: dos grupos que se alternan (marcha en trípode, como los insectos).
         Cada pata va dos veces: trazo oscuro grueso (borde) + trazo claro encima. -->
    <g class="patas patas-a" stroke-linecap="round" stroke-linejoin="round" fill="none">
      <g stroke="#140a33" stroke-width="4">
        <path d="M13 22 L5 16 L2 10" /><path d="M27 30 L35 31 L39 36" /><path d="M13 38 L6 43 L4 49" />
      </g>
      <g stroke="#e6dcff" stroke-width="2">
        <path d="M13 22 L5 16 L2 10" /><path d="M27 30 L35 31 L39 36" /><path d="M13 38 L6 43 L4 49" />
      </g>
    </g>
    <g class="patas patas-b" stroke-linecap="round" stroke-linejoin="round" fill="none">
      <g stroke="#140a33" stroke-width="4">
        <path d="M27 22 L35 16 L38 10" /><path d="M13 30 L5 31 L1 36" /><path d="M27 38 L34 43 L36 49" />
      </g>
      <g stroke="#e6dcff" stroke-width="2">
        <path d="M27 22 L35 16 L38 10" /><path d="M13 30 L5 31 L1 36" /><path d="M27 38 L34 43 L36 49" />
      </g>
    </g>
    <!-- antenas verdes, como las del avatar (con borde oscuro) -->
    <g class="antenas" stroke-linecap="round" fill="none">
      <g stroke="#140a33" stroke-width="3.4"><path d="M17 9 C 14 5, 11 3, 9 1" /><path d="M23 9 C 26 5, 29 3, 31 1" /></g>
      <g stroke="#8be32f" stroke-width="1.8"><path d="M17 9 C 14 5, 11 3, 9 1" /><path d="M23 9 C 26 5, 29 3, 31 1" /></g>
    </g>
    <circle cx="9" cy="1.8" r="2.3" fill="#6cc21c" stroke="#140a33" stroke-width="1" />
    <circle cx="31" cy="1.8" r="2.3" fill="#6cc21c" stroke="#140a33" stroke-width="1" />
    <!-- cabeza y cuerpo: lila claro con borde oscuro y manchas oscuras -->
    <circle cx="20" cy="12" r="6" fill="#2a1670" stroke="#140a33" stroke-width="1.4" />
    <ellipse cx="20" cy="31" rx="11" ry="15" fill="url(#bicho-cuerpo)" stroke="#140a33" stroke-width="1.6" />
    <path d="M20 17 L20 46" stroke="#140a33" stroke-width="1.3" />
    <circle cx="15" cy="26" r="2.6" fill="#3b1fb8" />
    <circle cx="25.5" cy="32" r="2.2" fill="#3b1fb8" />
    <circle cx="15" cy="38" r="1.9" fill="#3b1fb8" />
    <circle cx="25" cy="41" r="1.4" fill="#3b1fb8" />
    <circle cx="17.5" cy="10.5" r="1.4" fill="#fff" />
    <circle cx="22.5" cy="10.5" r="1.4" fill="#fff" />
    <defs>
      <radialGradient id="bicho-cuerpo" cx="0.35" cy="0.28" r="0.85">
        <stop offset="0" stop-color="#ffffff" />
        <stop offset="0.35" stop-color="#e0d0ff" />
        <stop offset="1" stop-color="#a98bff" />
      </radialGradient>
    </defs>
  </svg>
  </span>
  <span class="atrapado" aria-hidden="true">{t.atrapado}</span>
</button>

<style>
  .bicho {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 50;
    width: 34px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: crosshair;
    will-change: transform;
    filter: drop-shadow(0 0 6px rgba(160, 120, 255, 0.75)) drop-shadow(0 3px 3px rgba(0, 0, 0, 0.6));
    -webkit-tap-highlight-color: transparent;
  }
  .bicho[hidden] {
    display: none;
  }
  .bicho svg {
    display: block;
    overflow: visible;
  }
  /* el botón solo se traslada; .giro lo orienta hacia donde camina (así "¡Atrapado!" no sale al revés) */
  .giro {
    display: block;
    width: 34px;
    height: 44px;
  }
  /* las patas se mueven solo cuando camina */
  .bicho.camina .patas-a {
    animation: paso 0.16s ease-in-out infinite alternate;
  }
  .bicho.camina .patas-b {
    animation: paso 0.16s ease-in-out infinite alternate-reverse;
  }
  .bicho.corre .patas-a,
  .bicho.corre .patas-b {
    animation-duration: 0.07s;
  }
  @keyframes paso {
    from {
      transform: translateY(-2px);
    }
    to {
      transform: translateY(2px);
    }
  }
  /* cuando se detiene, mueve las antenas como "olfateando" */
  .bicho:not(.camina) .antenas {
    transform-origin: 20px 9px;
    animation: olfatear 0.5s ease-in-out infinite alternate;
  }
  @keyframes olfatear {
    from {
      transform: rotate(-6deg);
    }
    to {
      transform: rotate(6deg);
    }
  }
  .atrapado {
    position: absolute;
    left: 50%;
    top: -10px;
    opacity: 0;
    white-space: nowrap;
    padding: 3px 10px;
    border-radius: 10px;
    background: linear-gradient(100deg, var(--violeta-300), var(--lila-300));
    color: #0b0620;
    font: 700 0.8rem 'Space Grotesk', system-ui, sans-serif;
    pointer-events: none;
  }
  .bicho.cazado {
    cursor: default;
  }
  .bicho.cazado svg {
    animation: cazado 0.6s ease-out forwards;
  }
  .bicho.cazado .atrapado {
    animation: aviso 0.9s ease-out forwards;
  }
  @keyframes cazado {
    30% {
      transform: scale(1.35) rotate(25deg);
    }
    100% {
      transform: scale(0.85) rotate(180deg);
      opacity: 0.85;
    }
  }
  @keyframes aviso {
    0% {
      opacity: 0;
      transform: translate(-50%, 0) scale(0.5);
    }
    25% {
      opacity: 1;
      transform: translate(-50%, -18px) scale(1.05);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -26px) scale(1);
    }
  }
</style>

<script>
  const bicho = document.querySelector<HTMLButtonElement>('.bicho');
  const giro = bicho?.querySelector<HTMLElement>('.giro');
  const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (bicho && giro && !sinMovimiento) {
    const ya = new URLSearchParams(location.search).has('bicho');
    const azar = (a: number, b: number) => a + Math.random() * (b - a);

    let x = 0, y = 0, angulo = 0, destinoX = 0, destinoY = 0;
    let deambular = 0; // giro suave al azar, para que no camine en línea recta
    let pausaHasta = 0, huyendoHasta = 0, cansadoHasta = 0, inicio = 0;
    let raton = { x: -9999, y: -9999 };
    let raf = 0, activo = false;

    addEventListener('pointermove', (e) => (raton = { x: e.clientX, y: e.clientY }), { passive: true });

    function lanzar() {
      if (activo) return programar();
      if (document.hidden) {
        // pestaña en segundo plano: sale poco después de que vuelvas a ella
        document.addEventListener('visibilitychange', () => setTimeout(lanzar, azar(2000, 5000)), { once: true });
        return;
      }
      const W = innerWidth, H = innerHeight, m = 50;
      // entra por un borde al azar y va hacia el borde contrario
      const lado = Math.floor(Math.random() * 4);
      if (lado === 0) { x = -m; y = azar(0.2, 0.8) * H; destinoX = W + m; destinoY = azar(0.2, 0.8) * H; }
      if (lado === 1) { x = W + m; y = azar(0.2, 0.8) * H; destinoX = -m; destinoY = azar(0.2, 0.8) * H; }
      if (lado === 2) { y = -m; x = azar(0.2, 0.8) * W; destinoY = H + m; destinoX = azar(0.2, 0.8) * W; }
      if (lado === 3) { y = H + m; x = azar(0.2, 0.8) * W; destinoY = -m; destinoX = azar(0.2, 0.8) * W; }
      angulo = Math.atan2(destinoY - y, destinoX - x);
      activo = true;
      inicio = performance.now();
      pausaHasta = 0;
      bicho!.hidden = false;
      bicho!.classList.remove('cazado');
      let antes = performance.now();
      const paso = (ahora: number) => {
        const dt = Math.min(0.05, (ahora - antes) / 1000);
        antes = ahora;
        mover(ahora, dt);
        if (activo) raf = requestAnimationFrame(paso);
      };
      raf = requestAnimationFrame(paso);
    }

    function mover(ahora: number, dt: number) {
      const W = innerWidth, H = innerHeight;
      // huye si el mouse se acerca… pero se cansa: tras cada escape queda ~1,5 s sin poder huir
      // (esa es la oportunidad de atraparlo)
      const dRaton = Math.hypot(raton.x - x, raton.y - y);
      if (dRaton < 140 && ahora > cansadoHasta) {
        huyendoHasta = ahora + 600;
        cansadoHasta = ahora + 2100;
      }
      const huyendo = ahora < huyendoHasta;

      // de vez en cuando se detiene un momento
      if (!huyendo && ahora > pausaHasta + 1500 && Math.random() < dt * 0.35) pausaHasta = ahora + azar(350, 1100);
      const quieto = !huyendo && ahora < pausaHasta;

      let objetivo = Math.atan2(destinoY - y, destinoX - x);
      if (huyendo) objetivo = Math.atan2(y - raton.y, x - raton.x); // corre en dirección contraria al mouse
      deambular += (Math.random() - 0.5) * dt * 6;
      deambular *= 0.97;
      let diferencia = objetivo + deambular - angulo;
      diferencia = Math.atan2(Math.sin(diferencia), Math.cos(diferencia));
      angulo += diferencia * Math.min(1, dt * (huyendo ? 9 : 3));

      const velocidad = quieto ? 0 : huyendo ? 260 : 70;
      x += Math.cos(angulo) * velocidad * dt;
      y += Math.sin(angulo) * velocidad * dt;

      bicho!.classList.toggle('camina', !quieto);
      bicho!.classList.toggle('corre', huyendo);
      bicho!.style.transform = `translate(${x - 17}px, ${y - 22}px)`;
      giro!.style.transform = `rotate(${angulo + Math.PI / 2}rad)`; // el dibujo mira hacia arriba (-y)

      // se va cuando sale de la pantalla (o tras 40 s, por si acaso)
      const fuera = x < -80 || y < -80 || x > W + 80 || y > H + 80;
      if ((fuera && ahora - inicio > 1500) || ahora - inicio > 40000) terminar();
    }

    function terminar() {
      activo = false;
      cancelAnimationFrame(raf);
      bicho!.hidden = true;
      programar();
    }

    function programar() {
      setTimeout(lanzar, azar(40000, 80000)); // vuelve cada 40–80 s
    }

    bicho.addEventListener('click', () => {
      if (!activo) return;
      activo = false;
      cancelAnimationFrame(raf);
      bicho!.classList.remove('camina', 'corre');
      bicho!.classList.add('cazado');
      setTimeout(() => (location.href = bicho!.dataset.destino!), 750);
    });

    // Al volver con "atrás", el navegador restaura la página desde su memoria (bfcache) tal
    // como quedó: con el bicho congelado en "¡Atrapado!". Aquí se esconde y vuelve a salir después.
    addEventListener('pageshow', (e) => {
      if (!e.persisted || !bicho!.classList.contains('cazado')) return;
      bicho!.classList.remove('cazado', 'camina', 'corre');
      bicho!.hidden = true;
      activo = false;
      programar();
    });

    // primera aparición: 12–25 s después de entrar (o enseguida con ?bicho)
    setTimeout(lanzar, ya ? 300 : azar(12000, 25000));
  }
</script>
