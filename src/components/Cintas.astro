---
// Fondo decorativo: cintas de luz violeta (inspirado en el fondo de escritorio de Juan).
// Es solo SVG + CSS: no carga imágenes y no afecta la velocidad.
---

<div class="cintas" aria-hidden="true">
  <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="g-cinta" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#1b0a6b" stop-opacity="0" />
        <stop offset="0.35" stop-color="#5b3cf0" />
        <stop offset="0.6" stop-color="#d4a8ff" />
        <stop offset="1" stop-color="#3b1fb8" stop-opacity="0.2" />
      </linearGradient>
      <linearGradient id="g-cinta-2" x1="1" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#6d4aff" stop-opacity="0" />
        <stop offset="0.5" stop-color="#8f74ff" />
        <stop offset="1" stop-color="#2a1490" stop-opacity="0" />
      </linearGradient>
      <radialGradient id="g-velo" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#2a1490" stop-opacity="0.55" />
        <stop offset="1" stop-color="#2a1490" stop-opacity="0" />
      </radialGradient>
      <filter id="brillo" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="14" />
      </filter>
    </defs>

    <ellipse class="velo" cx="1150" cy="380" rx="520" ry="360" fill="url(#g-velo)" />

    <g class="grupo-a">
      <path
        class="halo"
        d="M-80 780 C 260 700, 620 640, 900 700 C 1080 740, 1260 840, 1500 980"
        stroke="url(#g-cinta)"
        stroke-width="46"
        fill="none"
        filter="url(#brillo)"
      />
      <path
        d="M-80 780 C 260 700, 620 640, 900 700 C 1080 740, 1260 840, 1500 980"
        stroke="url(#g-cinta)"
        stroke-width="5"
        fill="none"
      />
    </g>

    <g class="grupo-b">
      <path
        class="halo"
        d="M1180 -40 C 1000 120, 900 320, 960 520 C 1010 690, 1180 800, 1650 940"
        stroke="url(#g-cinta)"
        stroke-width="38"
        fill="none"
        filter="url(#brillo)"
      />
      <path
        d="M1180 -40 C 1000 120, 900 320, 960 520 C 1010 690, 1180 800, 1650 940"
        stroke="url(#g-cinta)"
        stroke-width="4"
        fill="none"
      />
    </g>

    <g class="grupo-c">
      <path
        d="M1640 60 C 1520 300, 1420 560, 1180 760 C 1040 870, 900 920, 760 960"
        stroke="url(#g-cinta-2)"
        stroke-width="2"
        fill="none"
      />
      <path
        class="halo"
        d="M380 260 C 240 380, 180 520, 300 640 C 420 760, 700 760, 860 720"
        stroke="url(#g-cinta-2)"
        stroke-width="22"
        fill="none"
        filter="url(#brillo)"
        opacity="0.7"
      />
      <path
        d="M380 260 C 240 380, 180 520, 300 640 C 420 760, 700 760, 860 720"
        stroke="url(#g-cinta-2)"
        stroke-width="1.5"
        fill="none"
      />
    </g>
  </svg>
</div>

<style>
  .cintas {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
  }
  svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .halo {
    opacity: 0.85;
  }
  .grupo-a {
    animation: flotar 16s ease-in-out infinite alternate;
  }
  .grupo-b {
    animation: flotar 20s ease-in-out infinite alternate-reverse;
  }
  .grupo-c {
    animation: flotar 24s ease-in-out infinite alternate;
  }
  .velo {
    animation: latir 10s ease-in-out infinite alternate;
  }
  @keyframes flotar {
    from {
      transform: translate(0, 0) rotate(0deg);
    }
    to {
      transform: translate(-30px, 18px) rotate(1.2deg);
    }
  }
  @keyframes latir {
    from {
      opacity: 0.6;
    }
    to {
      opacity: 1;
    }
  }
</style>
