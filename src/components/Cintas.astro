---
// Fondo decorativo: cintas de luz violeta (inspirado en el fondo de escritorio de Juan).
//
// Rendimiento: cada cinta es su PROPIO <svg> dentro de una capa (.capa) y lo que se anima es
// la capa entera con transform. Así el desenfoque (feGaussianBlur) se dibuja UNA vez y luego la
// GPU solo desplaza la capa. Antes se animaban <g> dentro de un solo SVG y Safari/iPhone (y Chrome
// sin GPU) tenía que redibujar el desenfoque en cada cuadro: la foto de perfil y la 404 se trababan.
// El "velo" es un degradado CSS que solo cambia de opacidad.
---

<div class="cintas" aria-hidden="true">
  <div class="capa velo"></div>

  <div class="capa capa-a">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id="cinta-a" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#1b0a6b" stop-opacity="0" />
          <stop offset="0.35" stop-color="#5b3cf0" />
          <stop offset="0.6" stop-color="#d4a8ff" />
          <stop offset="1" stop-color="#3b1fb8" stop-opacity="0.2" />
        </linearGradient>
        <filter id="brillo-a" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="14" />
        </filter>
      </defs>
      <path
        class="halo"
        d="M-80 780 C 260 700, 620 640, 900 700 C 1080 740, 1260 840, 1500 980"
        stroke="url(#cinta-a)"
        stroke-width="46"
        fill="none"
        filter="url(#brillo-a)"
      />
      <path
        d="M-80 780 C 260 700, 620 640, 900 700 C 1080 740, 1260 840, 1500 980"
        stroke="url(#cinta-a)"
        stroke-width="5"
        fill="none"
      />
    </svg>
  </div>

  <div class="capa capa-b">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id="cinta-b" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#1b0a6b" stop-opacity="0" />
          <stop offset="0.35" stop-color="#5b3cf0" />
          <stop offset="0.6" stop-color="#d4a8ff" />
          <stop offset="1" stop-color="#3b1fb8" stop-opacity="0.2" />
        </linearGradient>
        <filter id="brillo-b" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="14" />
        </filter>
      </defs>
      <path
        class="halo"
        d="M1180 -40 C 1000 120, 900 320, 960 520 C 1010 690, 1180 800, 1650 940"
        stroke="url(#cinta-b)"
        stroke-width="38"
        fill="none"
        filter="url(#brillo-b)"
      />
      <path
        d="M1180 -40 C 1000 120, 900 320, 960 520 C 1010 690, 1180 800, 1650 940"
        stroke="url(#cinta-b)"
        stroke-width="4"
        fill="none"
      />
    </svg>
  </div>

  <div class="capa capa-c">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id="cinta-c" x1="1" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#6d4aff" stop-opacity="0" />
          <stop offset="0.5" stop-color="#8f74ff" />
          <stop offset="1" stop-color="#2a1490" stop-opacity="0" />
        </linearGradient>
        <filter id="brillo-c" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="14" />
        </filter>
      </defs>
      <path
        d="M1640 60 C 1520 300, 1420 560, 1180 760 C 1040 870, 900 920, 760 960"
        stroke="url(#cinta-c)"
        stroke-width="2"
        fill="none"
      />
      <path
        class="halo"
        d="M380 260 C 240 380, 180 520, 300 640 C 420 760, 700 760, 860 720"
        stroke="url(#cinta-c)"
        stroke-width="22"
        fill="none"
        filter="url(#brillo-c)"
        opacity="0.7"
      />
      <path
        d="M380 260 C 240 380, 180 520, 300 640 C 420 760, 700 760, 860 720"
        stroke="url(#cinta-c)"
        stroke-width="1.5"
        fill="none"
      />
    </svg>
  </div>
</div>

<style>
  .cintas {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
  }
  .capa {
    position: absolute;
    inset: 0;
    will-change: transform; /* capa propia en la GPU: se dibuja una vez y solo se mueve */
  }
  .capa svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .halo {
    opacity: 0.85;
  }
  /* el velo violeta: antes era una elipse SVG; ahora un degradado CSS (mismo lugar y tamaño) */
  .velo {
    background: radial-gradient(
      32.5% 40% at 71.9% 42.2%,
      rgba(42, 20, 144, 0.55),
      rgba(42, 20, 144, 0) 100%
    );
    will-change: opacity;
    animation: latir 10s ease-in-out infinite alternate;
  }
  .capa-a {
    animation: flotar 16s ease-in-out infinite alternate;
  }
  .capa-b {
    animation: flotar 20s ease-in-out infinite alternate-reverse;
  }
  .capa-c {
    animation: flotar 24s ease-in-out infinite alternate;
  }
  @keyframes flotar {
    from {
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    to {
      transform: translate3d(-24px, 14px, 0) rotate(1.2deg);
    }
  }
  @keyframes latir {
    from {
      opacity: 0.6;
    }
    to {
      opacity: 1;
    }
  }
</style>
