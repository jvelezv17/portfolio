---
// Icono de una tecnología, en este orden:
// 1. imagen propia en public/logos/ (si `slug` empieza con '/')
// 2. logo de la librería simple-icons (SVG, licencia CC0) con su color de marca
// 3. monograma con las iniciales (ej. "ST")
import * as iconos from 'simple-icons';

interface Props {
  slug?: string; // ej. 'siCypress' — ver https://simpleicons.org
  nombre: string;
  mono?: string; // monograma a mano, ej. 'PW'
  color?: string; // color del monograma, ej. '#2EAD33'
  tamano?: number;
}

const { slug, nombre, mono, color: colorMono, tamano = 28 } = Astro.props;
// Si `slug` empieza con '/', es una imagen propia en public/ (ej. '/logos/playwright.png').
const imagen = slug?.startsWith('/') ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${slug}` : undefined;
const icono = slug && !imagen ?(iconos as Record<string, { path: string; hex: string } | undefined>)[slug] : undefined;

// Color original de la marca. Si es casi negro (GitHub, Java, JSON…) se usa blanco,
// que es la versión oficial de esos logos sobre fondo oscuro.
function colorMarca(hex: string) {
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
  const luminancia = 0.2126 * r + 0.7152 * g + 0.0722 * b;
  return luminancia < 0.12 ? '#ffffff' : `#${hex}`;
}
const color = icono ? colorMarca(icono.hex) : undefined;
const monograma = mono ?? nombre
  .split(/[\s.\-()]+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((p) => p[0])
  .join('')
  .toUpperCase();
---

{
  imagen ? (
    <img class="icono" src={imagen} width={tamano} height={tamano} alt="" loading="lazy" decoding="async" />
  ) : icono ? (
    <svg class="icono" viewBox="0 0 24 24" width={tamano} height={tamano} aria-hidden="true">
      <path d={icono.path} fill={color} />
    </svg>
  ) : (
    <span
      class="icono monograma"
      style={`--t:${tamano}px;${colorMono ? `color:${colorMono}` : ''}`}
      aria-hidden="true"
    >
      {monograma}
    </span>
  )
}

<style>
  .icono {
    flex: none;
  }
  .monograma {
    display: inline-grid;
    place-items: center;
    width: var(--t);
    height: var(--t);
    border-radius: 8px;
    border: 1.5px solid currentColor;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: calc(var(--t) * 0.42);
    font-weight: 700;
    letter-spacing: 0;
  }
</style>
